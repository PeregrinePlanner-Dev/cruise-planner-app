SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
RESEND_API_KEY=re_your_key_here
ADVISOR_EMAIL=your_advisor_email@example.com
DEV_FLUSH_KEY=your_secret_dev_key_here
# Leave ALLOW_DEV_FLUSH unset (or "false") on Render/production. Only set to
# "true" in a local/dev environment where wiping voyage_profiles is intended
# and safe. This is a second, independent gate on /dev/flush-sessions on top
# of DEV_FLUSH_KEY -- see app.py.
ALLOW_DEV_FLUSH=false
FLASK_SECRET=set_this_to_a_long_random_string_in_production
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here
